"""
配置示例文件 — 複製為 .env 並填入實際值

基於 Polsia 成本優化經驗：優先使用 OpenRouter 聚合多模型，
在需要時切換到低成本中國開源模型
"""
# ── LLM Provider API Keys ───────────────────────────────────────
# 推薦：OpenRouter（聚合多模型，自動降級）
# 文檔：https://openrouter.ai/
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic（用於需要強推理的規劃階段）
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI（備用）
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── 數據庫 ──────────────────────────────────────────────────────
# PostgreSQL（推薦使用 Supabase 免費層）
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/agent_os

# Redis（用於任務隊列和緩存）
REDIS_URL=redis://localhost:6379/0

# ── 向量存儲 ────────────────────────────────────────────────────
# ChromaDB 本地存儲路徑
CHROMA_PATH=./storage/chroma_db

# ── 部署 ────────────────────────────────────────────────────────
# Vercel Token（用於自動部署 Landing Page）
# 獲取方式：vercel login → vercel token
VERCEL_TOKEN=vcpt_xxxxxxxxxxxxxxxxxxxxxxxx

# 部署基礎 URL
DEPLOYMENT_BASE_URL=https://your-project.vercel.app

# ── 郵件服務（Outreach Agent）───────────────────────────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
FROM_EMAIL=noreply@agent-os.app

# ── 社交媒體 API（Marketing Agent）──────────────────────────────
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ── 應用配置 ────────────────────────────────────────────────────
# 運行模式：development / production
APP_ENV=development

# 日誌級別：debug / info / warning / error
LOG_LEVEL=info

# 是否啟用成本監控
COST_MONITORING_ENABLED=true

# 每日 Token 預算（全局）
DAILY_TOKEN_BUDGET=10000000
